            eventCard(
              context,
              "Tech Fest 2026",
              "10 October 2026",
              "College Auditorium",
              Icons.computer,
            ),

            eventCard(
              context,
              "Annual Sports Meet",
              "15 October 2026",
              "College Ground",
              Icons.sports_cricket,
            ),

            eventCard(
              context,
              "Cultural Fest",
              "20 October 2026",
              "Main Campus",
              Icons.celebration,
